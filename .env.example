# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env   (Mac/Linux)
# copy .env.example .env (Windows)

# ── LLM settings (used by LLMFactory via LiteLLM) ────────────────────────────
# The LiteLLM model string for Groq
MODEL_NAME="groq/llama3-8b-8192"
TEMPERATURE=0.0
MAX_TOKENS=512

# ── Embedder settings (used by LocalEmbedder) ────────────────────────
EMBED_MODEL_NAME="all-MiniLM-L6-v2"

# ── API Keys ──────────────────────────────────────────────────────────────────
# Your Groq API Key
GROQ_API_KEY="gsk_..."

# ── RAG pipeline tuning ───────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=800        # max tokens per document chunk
CHUNK_OVERLAP_TOKENS=100     # token overlap between consecutive chunks
TOP_K=5                      # number of chunks to retrieve per query
SIMILARITY_THRESHOLD=0.8     # max cosine distance to accept a chunk (0.0 = exact)
MAX_RETRIEVAL_ATTEMPTS=3     # how many times to rewrite and retry before giving up

# ── Optional: LangSmith tracing ───────────────────────────────────────────────
# Uncomment and set to enable LangGraph execution tracing on LangSmith.
# LANGCHAIN_API_KEY="lsv2_..."
