# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ───────────────────────────────────────────────────────
.env
.venv/
env/
venv/
ENV/

# ── Secrets — NEVER commit these ──────────────────────────────────────────────
# .env is gitignored; commit .env.example instead
*.env

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
dist/

# ── Data files ────────────────────────────────────────────────────────────────
# Exclude the PubMed corpus (can be re-fetched with fetch_papers.py)
data/corpus.json
# Exclude downloaded PDFs (can be re-fetched)
data/academic_papers/*.pdf

# ── ChromaDB on-disk collection ────────────────────────────────────────────────
# The vector store is rebuilt via `python -m src.main --build-store`
src/vectordb/chroma_collection/

# ── Evaluation output ─────────────────────────────────────────────────────────
ragas_results.json

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.agents/

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
